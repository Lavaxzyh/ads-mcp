TECHFORMAT=V2

UNITS
  DISTANCE=METRE
  CONDUCTIVITY=SIEMENS/M
  RESISTIVITY=OHM.CM
  RESISTANCE=OHM/SQ
  PERMITTIVITY=RELATIVETOVACUUM
  PERMEABILITY=RELATIVETOVACUUM
  FREQUENCY=HZ
  TEMPERATURE=CELSIUS
END_UNITS

BEGIN_MATERIAL
  MATERIAL MCP_C_86c7183804044944 CONDUCTIVITY=58000000.0 IMAG_CONDUCTIVITY=0 PERMEABILITY=1
  MATERIAL MCP_D_ed2f2f6fee8e5597 PERMITTIVITY=2.55 LOSSTANGENT=0.0012 PERMEABILITY=1
END_MATERIAL

BEGIN_PLATING
  PLATING hole THICKNESS=2.4999999999999998e-05 MATERIAL=AIR
END_PLATING

BEGIN_OPERATION
  OPERATION OperationSHEET SHEET
  OPERATION OperationThickness_cond INTRUDE=1.7e-05 UP
  OPERATION OperationDRILL DRILL
  OPERATION OperationTSV_hole DRILL PLATING=hole
END_OPERATION

BEGIN_MASK
  MASK 1 Name=cond PRECEDENCE=0 COLOR="ee6a50" MATERIAL=MCP_C_86c7183804044944 OPERATION=OperationThickness_cond
  MASK 5 Name=hole PRECEDENCE=0 COLOR="00bfff" MATERIAL=MCP_C_86c7183804044944 OPERATION=OperationDRILL
END_MASK

BEGIN_STACK
  TOP OPEN MATERIAL=AIR
  INTERFACE Name=__Interface1      MASK={cond}
  LAYER     Name=__SubstrateLayer1 MASK={hole} HEIGHT=0.0005 MATERIAL=MCP_D_ed2f2f6fee8e5597
  BOTTOM COVERED MATERIAL=PERFECT_CONDUCTOR
END_STACK

