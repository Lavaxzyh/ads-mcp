; Top Design: "meander14_lib:rtps180_final_reverse:schematic"
; Netlisted using Hierarchy Policy: "Standard"

Options ResourceUsage=yes UseNutmegFormat=no EnableOptim=no TopDesignName="meander14_lib:rtps180_final_reverse:schematic" DcopOutputNodeVoltages=yes DcopOutputPinCurrents=yes DcopOutputAllSweepPoints=no DcopOutputDcopType=0
; Library Name: meander14_lib
; Cell Name: rtps180_compact80
; View Name: emModel
define rtps180_compact80 ( RF_IN  RF_OUT  A1_C1_A  A1_C1_B  A1_D_A  A1_D_B  A1_LP_A  A1_LP_B  A1_C3_A  A1_C3_B  A1_CHOKE_A  A1_CHOKE_B  A1_C2_A  A1_C2_B  A1_R_A  A1_R_B  A2_C1_A  A2_C1_B  A2_D_A  A2_D_B  A2_LP_A  A2_LP_B  A2_C3_A  A2_C3_B  A2_CHOKE_A  A2_CHOKE_B  A2_C2_A  A2_C2_B  A2_R_A  A2_R_B  BIAS1  BIAS2  ref=0 ) 
;parameters 
; MomCmpt model has node 0 as implicit reference. Ref node will be ignored and assumed to be grounded!
em_data_name="meander14_lib:rtps180_compact80:emModel"
MomCmpt:em_data  RF_IN RF_OUT A1_C1_A A1_C1_B A1_D_A A1_D_B A1_LP_A A1_LP_B A1_C3_A A1_C3_B \
   A1_CHOKE_A A1_CHOKE_B A1_C2_A A1_C2_B A1_R_A A1_R_B A2_C1_A A2_C1_B A2_D_A A2_D_B \
   A2_LP_A A2_LP_B A2_C3_A A2_C3_B A2_CHOKE_A A2_CHOKE_B A2_C2_A A2_C2_B A2_R_A A2_R_B \
   BIAS1 BIAS2 \
    name=em_data_name \
    paramFile="" \
    modelFile="C:/ADS/examples/pin_phase_shifter_1p4ghz/workspace/meander14_lib/rtps180_compact80/em%Model/model.ndx" \
    ModelReuse=1 \
    ModelType="MOMMW" \
    ExtrapolationMode="linear" \
    EnforcePassivity=-1
end rtps180_compact80

